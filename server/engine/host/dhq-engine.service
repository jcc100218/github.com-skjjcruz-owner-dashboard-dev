[Unit]
Description=DHQ engine build (one run)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
EnvironmentFile=/etc/dhq-engine.env
# Room for 15-minute game-day runs: stop starting leagues after 11 minutes.
Environment=ENGINE_BUDGET_MIN=11
ExecStart=/opt/dhq/app/server/engine/host/build.sh
TimeoutStartSec=15min
Nice=5
